{
  "name": "velero-ui",
  "version": "0.2.7",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev --turbopack",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --format json --output-file eslint-report.json",
    "lint:cache": "eslint . --cache --cache-location .cache/eslint/.eslintcache",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\"",
    "jest": "jest --passWithNoTests",
    "jest:watch": "jest --watch",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\"",
    "prettier:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\"",
    "test": "pnpm run prettier:check && pnpm run lint && pnpm run typecheck && pnpm run jest",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod",
    "audit:signatures": "pnpm audit signatures"
  },
  "dependencies": {
    "@mantine/charts": "^8.0.2",
